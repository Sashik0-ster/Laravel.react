{
  "$schema": "https://railpack.com/schemas/config.v1.json",
  "php": {
    "version": "8.4",
    "extensions": [
      "ctype",
      "curl",
      "dom",
      "fileinfo",
      "filter",
      "hash",
      "mbstring",
      "openssl",
      "pcre",
      "pdo",
      "session",
      "tokenizer",
      "xml",
      "pdo_mysql"
    ]
  },
  "node": {
    "version": "22"
  },
  "deploy": {
    "startCommand": "php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=$PORT"
  }
}
